# Base Neon (ajoutée automatiquement par l'intégration Neon sur Vercel)
DATABASE_URL="postgres://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Stockage des PDF (ajouté automatiquement quand tu crées un Blob Store sur Vercel)
# En local, si cette variable est absente, les PDF sont enregistrés dans le dossier .local-uploads
BLOB_READ_WRITE_TOKEN=""

# Mot de passe de l'espace /admin
ADMIN_PASSWORD="change-moi"

# Chaîne aléatoire utilisée pour signer la session admin (facultatif mais conseillé)
SESSION_SECRET="une-longue-chaine-aleatoire"
